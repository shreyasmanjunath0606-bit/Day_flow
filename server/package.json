{
  "name": "dayflow-backend",
  "version": "1.0.0",
  "description": "Node.js Express backend server with MySQL database integration for DayFlow HR",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed": "node seed.js",
    "db:migrate": "node --require dotenv/config ./node_modules/db-migrate/bin/db-migrate up"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "db-migrate": "^0.11.14",
    "db-migrate-mysql": "^3.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0"
  }
}
